# =============================================================================
# Copernico - .env.example ampliado
# Configuración completa del proyecto
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# CREDENCIALES COLOMBUS DATA SPACE (Sentinel-1/2)
# Registro: https://identity.dataspace.copernicus.eu/
# ─────────────────────────────────────────────────────────────────────────────
CDSE_USER=tu_usuario_registrado
CDSE_PASSWORD=tu_contrasena

# ─────────────────────────────────────────────────────────────────────────────
# CREDENCIALES NASA EARTHDATA (alternativa ASF Vertex, más rápida)
# Registro: https://urs.earthdata.nasa.gov/users/new
# ─────────────────────────────────────────────────────────────────────────────
EARTHDATA_USER=
EARTHDATA_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# CREDENCIALES COPERNICUS CLIMATE DATA STORE (ERA5 para corrección atmosférica)
# Registro: https://cds.climate.copernicus.eu/
# ─────────────────────────────────────────────────────────────────────────────
CDS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE EARTH ENGINE (opcional, para mosaicos Sentinel-2 pre-procesados)
# Registro: https://earthengine.google.com/
# ─────────────────────────────────────────────────────────────────────────────
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT=

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN DEL PROYECTO
# ─────────────────────────────────────────────────────────────────────────────

# Zonas de interés (bounding boxes)
SAMANGA_BAJA_LAT_MIN=2.382871
SAMANGA_BAJA_LAT_MAX=2.418983
SAMANGA_BAJA_LON_MIN=-76.587846
SAMANGA_BAJA_LON_MAX=-76.551913

PURACE_LAT_MIN=2.250
PURACE_LAT_MAX=2.320
PURACE_LON_MIN=-76.450
PURACE_LON_MAX=-76.350

SOTARA_LAT_MIN=2.070
SOTARA_LAT_MAX=2.150
SOTARA_LON_MIN=-76.630
SOTARA_LON_MAX=-76.550

# Parámetros de procesamiento InSAR
AS_THRESHOLD_PS=0.75
AS_THRESHOLD_SBAS=0.60
MIN_TEMP_BASELINE_DAYS=12
MAX_TEMP_BASELINE_DAYS=120
MIN_PERP_BASELINE_M=-200
MAX_PERP_BASELINE_M=200

# Configuración MintPy
MINTPY_NETWORK_TYPE=smallbaseline
MINTPY_ATMOS_CORRECTION=pyaps
MINTPY_DERAMP=linear

# Configuración SNAP
SNAP_DEM_NAME=SRTM 1Sec HGT
SNAP_GPT_MEMORY=4G

# Logging
LOG_LEVEL=INFO
LOG_FILE=/outputs/copernico.log

# Directorios (en contenedor)
DATA_DIR=/data
OUTPUTS_DIR=/outputs
